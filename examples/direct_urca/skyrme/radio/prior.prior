# Prior file for standalone Skyrme model

# Momentum and Extended Skyrme Parameters
# Skyrme / generalized-Skyrme sector
t2 = UniformPrior(-1000.0, 700.0, parameter_names=["t2"])
t4 = UniformPrior(-1000.0, 300.0, parameter_names=["t4"])
x0 = UniformPrior(-2.5, 2.5, parameter_names=["x0"])
x1 = UniformPrior(-3.0, 240, parameter_names=["x1"])
x4 = UniformPrior(-5.0, 7.0, parameter_names=["x4"])

# Density Exponents
# Covers standard Skyrme-like alpha ~ 1/6, 1/3,
# BSk-like alpha/gamma = 1/12,
# and extended Skyrme eMSL-like beta = gamma = 1.
alph = UniformPrior(0.0, 1.0, parameter_names=["alph"])
beta = UniformPrior(0.0, 1.2, parameter_names=["beta"])
gamma = UniformPrior(0.0, 1.2, parameter_names=["gamma"])

# Macroscopic Empirical Parameters
# Saturation Fermi momentum.
# Corresponds roughly to broad n_sat ~ 0.13-0.19 fm^-3.
kfsat = UniformPrior(1.25, 1.42, parameter_names=["kfsat"])
# Energy per baryon at saturation.
av = UniformPrior(-17.5, -13.0, parameter_names=["av"])
# Symmetry energy at saturation.
J = UniformPrior(20.0, 45.0, parameter_names=["J"])
# Isoscalar and isovector effective masses.
meffs = UniformPrior(0.35, 1.20, parameter_names=["meffs"])
meffv = UniformPrior(0.30, 1.20, parameter_names=["meffv"])
# Incompressibility.
Kinf = UniformPrior(150.0, 450.0, parameter_names=["Kinf"])

# High-Density Parameter
# High-density neutron-matter energy-like control parameter.
# Keep broad unless you define the exact density and convention.
eNMhd = UniformPrior(50.0, 1200.0, parameter_names=["eNMhd"])