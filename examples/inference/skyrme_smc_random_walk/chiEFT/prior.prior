# Prior file for Skyrme-CSE model
# Based on ranges in eos_tov_skryme.ipynb
t2 = UniformPrior(-1.0, 1.0, parameter_names=["t2"])
t4 = UniformPrior(-400.0, 0.0, parameter_names=["t4"])
x0 = UniformPrior(-1.0, 0.0, parameter_names=["x0"])
x1 = UniformPrior(-5.0, 5.0, parameter_names=["x1"])
x4 = UniformPrior(-5.0, 5.0, parameter_names=["x4"])
alph = UniformPrior(0.1, 0.4, parameter_names=["alph"])
beta = UniformPrior(0.0, 1.0, parameter_names=["beta"])
gamma = UniformPrior(0.0, 1.0, parameter_names=["gamma"])
kfsat = UniformPrior(1.2, 1.5, parameter_names=["kfsat"])
av = UniformPrior(-18.0, -14.0, parameter_names=["av"])
J = UniformPrior(28.0, 40.0, parameter_names=["J"])
meffs = UniformPrior(0.6, 1.1, parameter_names=["meffs"])
meffv = UniformPrior(0.6, 1.1, parameter_names=["meffv"])
Kinf = UniformPrior(210.0, 280.0, parameter_names=["Kinf"])
eNMhd = UniformPrior(100.0, 300.0, parameter_names=["eNMhd"])
nbreak = UniformPrior(0.16, 0.6, parameter_names=["nbreak"])
