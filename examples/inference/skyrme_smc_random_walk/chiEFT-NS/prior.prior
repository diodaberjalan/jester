# Prior file for Skyrme-CSE model

# Momentum and Extended Skyrme Parameters
t2 = UniformPrior(-1e-2, 1.0e-1, parameter_names=["t2"])
t4 = UniformPrior(-500.0, 0.0, parameter_names=["t4"])
x0 = UniformPrior(-1.0, 1.0, parameter_names=["x0"])
x1 = UniformPrior(-1.0, 230.0, parameter_names=["x1"])
x4 = UniformPrior(-5.0, 7.0, parameter_names=["x4"])

# Density Exponents
alph = UniformPrior(0.05, 0.2, parameter_names=["alph"])
beta = UniformPrior(0.01, 0.5, parameter_names=["beta"])
gamma = UniformPrior(0.01, 0.3, parameter_names=["gamma"])

# Macroscopic Empirical Parameters
kfsat = UniformPrior(1.32, 1.34, parameter_names=["kfsat"])
av = UniformPrior(-17.0, -14.5, parameter_names=["av"])
J = UniformPrior(28.0, 40.0, parameter_names=["J"])
meffs = UniformPrior(0.7, 1., parameter_names=["meffs"])
meffv = UniformPrior(0.7, 1., parameter_names=["meffv"])
Kinf = UniformPrior(210.0, 280.0, parameter_names=["Kinf"])

# High-Density and Transition Parameters
eNMhd = UniformPrior(200.0, 500.0, parameter_names=["eNMhd"])
nbreak = UniformPrior(1, 1.2, parameter_names=["nbreak"])